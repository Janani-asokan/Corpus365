# Public base URL, used for referral links, emails and Razorpay callbacks.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL 16) ------------------------------------------------
DATABASE_URL=postgres://corpus:corpus@localhost:5432/corpus365
# "disable" for a local server without TLS. In production leave unset (TLS on).
DATABASE_SSL=disable
# Server CA certificate (PEM). DigitalOcean App Platform: ${db.CA_CERT}
# DATABASE_CA_CERT=
# Connections per app instance. Keep instances × this under your plan's limit.
# DATABASE_POOL_MAX=10
# Tests use a separate database whose name must end in _test.
# TEST_DATABASE_URL=postgres://corpus:corpus@localhost:5432/corpus365_test

# --- First admin (production bootstrap only) --------------------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Payments ----------------------------------------------------------------
# "razorpay" for real payments, "test" for instant fake payments (dev only).
PAYMENT_PROVIDER=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Production refuses test payments unless this is "true" (staging demos only).
# ALLOW_TEST_PAYMENTS=false

# Shared secret for the daily billing job: POST /api/cron/billing
CRON_SECRET=
