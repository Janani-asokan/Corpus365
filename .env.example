# Public base URL, used for referral links, emails and Razorpay callbacks.
APP_URL=http://localhost:3000
# SQLite file path. Swap the Drizzle driver for Postgres in production.
DATABASE_PATH=./data/corpus365.db

# --- Payments -------------------------------------------------------------
# "razorpay" for real payments, "test" for instant fake payments (dev only).
# Defaults to razorpay when RAZORPAY_KEY_ID is set, otherwise test.
PAYMENT_PROVIDER=test
# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_… first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → secret you choose for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Production refuses test payments unless this is "true" (staging demos only).
# ALLOW_TEST_PAYMENTS=false

# Shared secret for the daily billing job: POST /api/cron/billing
CRON_SECRET=
